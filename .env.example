# Copy to .env and fill in. Never commit .env.

# Login for the web app (user "reader"). Required with docker compose.
MARGIN_PASSWORD=
# Postgres password for docker compose.
DB_PASSWORD=

# Optional. Without it, Margin quotes the best passages instead of writing answers.
ANTHROPIC_API_KEY=
# Optional. Without it, search is keywords only (no semantic search).
VOYAGE_API_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///./margin.db
# MARGIN_MODEL=claude-opus-5-5
# MARGIN_EFFORT=medium
